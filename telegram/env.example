# Пример env.example
# Demo sidecar (compose.demo.yml): токены как в compose.env.example (demo-plugin-ingress / demo-internal-key).
# External stack (docker-compose.yml): секция prod-like в compose.env.example.

NODE_ENV=production

PLUGIN_TCP_PORT=9400
EXECUTOR_TCP_PORT=9400
PORT=9400

PLUGIN_PULL_ADVERTISED_HOST=telegram

# --- demo (sidecar к kosolapus/conveyor-demo) ---
# PLUGIN_MANAGER_INGRESS_TOKEN=demo-plugin-ingress
# PLUGIN_MANAGER_RPC_HOST=demo
# PLUGIN_MANAGER_RPC_PORT=4016
# PLUGIN_CONTROL_PLANE_KEY=demo-internal-key
# CONTROL_PLANE_TCP_HOST=demo
# RUNTIME_CONTROL_PLANE_TCP_PORT=4021

# --- external stack (prod-like в compose.env.example) ---
PLUGIN_MANAGER_INGRESS_TOKEN=dev-plugin-ingress
PLUGIN_MANAGER_RPC_HOST=plugin-manager
PLUGIN_MANAGER_RPC_PORT=3000
PLUGIN_CONTROL_PLANE_KEY=dev-internal-key
CONTROL_PLANE_TCP_HOST=runtime-control-plane
RUNTIME_CONTROL_PLANE_TCP_PORT=3001
