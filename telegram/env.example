# Copy to .env and adjust. docker compose reads .env from this directory.

# --- Runtime (current publication-only entrypoint: src/main.ts) ---
NODE_ENV=production

# TCP port the plugin listens on inside the container (Nest publication batch pull).
PLUGIN_TCP_PORT=9400

# Host port mapped to the container (Compose ports left:right).
PLUGIN_TCP_HOST_PORT=9400

# Must match plugin-manager PLUGIN_MANAGER_INGRESS_TOKEN (SDK: manifest + inbound batch pull token).
PLUGIN_MANAGER_INGRESS_TOKEN=dev-plugin-ingress

# plugin-manager TCP (manifest_request on startup unless disabled below).
PLUGIN_MANAGER_RPC_HOST=127.0.0.1
# С docker-compose.dev (сервис plugin-manager): по умолчанию TCP ПМ — 4016 (не 4014: на хосте 4014 часто search-service).
PLUGIN_MANAGER_RPC_PORT=4016

# Set to true to skip outbound manifest handshake (no plugin_wire_outbound_manifest_* logs).
# PLUGIN_MANAGER_MANIFEST_ON_INIT_DISABLED=false

# --- Control plane TCP (step-ack / step-result через Nest TCP на CP), не HTTP /internal ---
PLUGIN_CONTROL_PLANE_KEY=dev-internal-key
CONTROL_PLANE_TCP_HOST=127.0.0.1
RUNTIME_CONTROL_PLANE_TCP_PORT=4021
# Альтернативное имя хоста (как в backend): RUNTIME_ENGINE_TCP_HOST=...

# Если CP отклоняет с peer IP контейнера — расширьте PLUGIN_CONTROL_PLANE_ALLOW_CIDRS на стороне CP.

# Optional: host PM uses for manifest `pull` (default 127.0.0.1). With PM in Docker, use e.g. host.docker.internal + matching published port.

# Optional image tag/name after build.
TELEGRAM_PLUGIN_IMAGE=plugin-telegram:latest

# --- Build (docker compose build) ---
# Local: `npm ci && npm run build` — produces dist/run.cjs + dist/help.md (SDK from file: is bundled).
# Image uses Dockerfile.dist and does not run npm in the container.
NPM_AUTH_TOKEN=

# --- Optional runtime ---
TZ=UTC
NODE_OPTIONS=

# EXECUTOR_TCP_PORT и PORT — см. Dockerfile / compose; HEALTH — bootstrapPluginExecutorMicroservice.
# DISABLE_RUNTIME_STEP_ACK=true — не слать step-ack.
