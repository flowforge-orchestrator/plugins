# Пример для локального запуска; в Docker см. ../docker-compose.yml (сервис telegram).
NODE_ENV=production

# TCP ingress (executor.task + publication batch pull) — как у остальных плагинов.
PLUGIN_TCP_PORT=9400
EXECUTOR_TCP_PORT=9400
PORT=9400

# Опционально: HTTP GET /health (тогда нужен @nestjs/platform-express и второй порт).
# PLUGIN_HEALTH_HTTP_PORT=9480

# Как в общем стеке в одной Docker-сети:
PLUGIN_PULL_ADVERTISED_HOST=telegram
PLUGIN_MANAGER_INGRESS_TOKEN=dev-plugin-ingress
PLUGIN_MANAGER_RPC_HOST=plugin-manager
PLUGIN_MANAGER_RPC_PORT=3000

PLUGIN_CONTROL_PLANE_KEY=dev-internal-key
CONTROL_PLANE_TCP_HOST=runtime-control-plane
RUNTIME_CONTROL_PLANE_TCP_PORT=3001

# С хоста к контейнерам: host.docker.internal и порты публикации 4016 / 4021.
