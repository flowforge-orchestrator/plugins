# Runtime image: only the bundled artifact (no node_modules).
#
# Build on the host in this repo (needs devDeps for tsc + esbuild):
#   npm ci
#   npm run build
# → dist/run.cjs + dist/help.md
#
#   docker build -f Dockerfile.dist -t plugin-telegram:latest .
#
# `@kosolapus/plugin-ts-sdk` is resolved from npm at build time and inlined into run.cjs.
#
# Runtime: EXECUTOR_TCP_PORT; к runtime-control-plane — TCP ingress: PLUGIN_CONTROL_PLANE_KEY,
# CONTROL_PLANE_TCP_HOST / RUNTIME_ENGINE_TCP_HOST, RUNTIME_CONTROL_PLANE_TCP_PORT;
# PLUGIN_MANAGER_INGRESS_TOKEN (PM ingress), PLUGIN_MANAGER_RPC_*, ...

FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=production
# Avoid 4014: on many dev setups localhost:4014 is search-service, not plugin-manager TCP.
ENV PLUGIN_MANAGER_RPC_PORT=4016

COPY dist/run.cjs dist/help.md ./

USER node
CMD ["node", "run.cjs"]
