NODE_ENV=production

PLUGIN_TCP_PORT=9413
EXECUTOR_TCP_PORT=9413
PORT=9413

# Docker demo (сервис caldav в compose):
PLUGIN_PULL_ADVERTISED_HOST=caldav
PLUGIN_MANAGER_INGRESS_TOKEN=demo-plugin-ingress
PLUGIN_CONTROL_PLANE_KEY=demo-internal-key
PLUGIN_MANAGER_RPC_HOST=demo
PLUGIN_MANAGER_RPC_PORT=4016
CONTROL_PLANE_TCP_HOST=demo
RUNTIME_CONTROL_PLANE_TCP_PORT=4021

# Локально к demo на хосте:
# PLUGIN_MANAGER_RPC_HOST=127.0.0.1
# PLUGIN_PULL_ADVERTISED_HOST=127.0.0.1
