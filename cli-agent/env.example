NODE_ENV=production

PLUGIN_TCP_PORT=9416
EXECUTOR_TCP_PORT=9416
PORT=9416
PLUGIN_PUBLICATION_VERSION=0.0.1

PLUGIN_PULL_ADVERTISED_HOST=cli-agent
PLUGIN_MANAGER_INGRESS_TOKEN=demo-plugin-ingress
PLUGIN_CONTROL_PLANE_KEY=demo-internal-key
PLUGIN_MANAGER_RPC_HOST=demo
PLUGIN_MANAGER_RPC_PORT=4016
CONTROL_PLANE_TCP_HOST=demo
RUNTIME_CONTROL_PLANE_TCP_PORT=4021

# Host directory that may be bind-mounted into agent containers as /workspace.
CLI_AGENT_WORKSPACE_ROOT=/var/lib/cli-agent/workspaces

# Docker Engine socket.
# DOCKER_SOCKET=/var/run/docker.sock

# A2A hub for plugin.cli-agent.factory: agent containers call it from the default bridge.
# CLI_AGENT_A2A_PORT=9419
# CLI_AGENT_A2A_URL=http://host.docker.internal:9419

# GigaChat (llm-config.gigachat): create secret GIGACHAT_AUTH_KEY in the editor
# (Authorization key from the cabinet). Combiner: CLI_LLM=gigachat.
# TLS uses the bundled НУЦ Минцифры CA — no NODE_EXTRA_CA_CERTS needed on the sidecar.
