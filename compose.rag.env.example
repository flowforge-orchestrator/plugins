# Local Docker build of @conveyor/plugin-rag against a running Conveyor demo.
#
#   docker compose -f compose.rag.yml --env-file compose.rag.env.example up -d --build
#
# Requires: Ollama on the host with embeddinggemma:latest + gemma4:12b-mlx (or override models).

# --- attach to which demo network ---
# compose.demo.yml project name → conveyor-plugins-demo_default
# Hub/flowforge demo on this machine → flowforge-demo_default
DEMO_NETWORK_NAME=flowforge-demo_default

# Tokens must match the demo container (Hub demo often uses "key")
PLUGIN_CONTROL_PLANE_KEY=key
PLUGIN_MANAGER_INGRESS_TOKEN=key

# DNS name of the demo service inside DEMO_NETWORK_NAME
CONTROL_PLANE_TCP_HOST=demo
PLUGIN_MANAGER_RPC_HOST=demo
DEMO_CP_TCP_PORT=4021
DEMO_PM_TCP_PORT=4016

DEMO_RAG_EXECUTOR_PORT=9406
DEMO_RAG_HEALTH_PORT=9407
DEMO_RAG_PULL_HOST=rag
RAG_PUBLICATION_VERSION=0.0.4
RAG_NEO4J_PASSWORD=rag-neo4j-local

# Ollama on Docker host
EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDING_MODEL=embeddinggemma:latest
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=gemma4:12b-mlx
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_MS=180000
