{
  "name": "@conveyor/plugins-workspace",
  "private": true,
  "description": "Conveyor external plugin processes (workspace root)",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "plugin-build-tools",
    "office",
    "email",
    "telegram",
    "jira",
    "redmine",
    "llm",
    "caldav"
  ],
  "overrides": {
    "@kosolapus/plugin-ts-sdk": "0.0.9"
  },
  "scripts": {
    "build:all": "npm run build --workspaces --if-present",
    "test:example-plugin": "npm test --prefix .cursor/skills/plugin-author/example-plugin"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5"
  }
}
