# Переменные для Docker Compose в корне репозитория.
#   docker compose -f compose.demo.yml --env-file compose.env.example up -d --build

# ---- compose.demo.yml (demo + jira, telegram, llm, caldav) ----

DEMO_IMAGE_REF=kosolapus/conveyor-demo:latest
DEMO_WEB_PORT=8080
DEMO_CP_HTTP_PORT=4020
DEMO_CP_TCP_PORT=4021
DEMO_PM_TCP_PORT=4016
DEMO_PM_HEALTH_PORT=4017

POSTGRES_PASSWORD=postgres
JWT_SECRET=demo-change-me
PLUGIN_CONTROL_PLANE_KEY=demo-internal-key
PLUGIN_MANAGER_INGRESS_TOKEN=demo-plugin-ingress
PUBLIC_SITE_URL=http://localhost:8080


# DEMO_JIRA_EXECUTOR_PORT=9401
# DEMO_TELEGRAM_EXECUTOR_PORT=9400
# DEMO_LLM_EXECUTOR_PORT=9404
# DEMO_CALDAV_EXECUTOR_PORT=9413

# ---- compose.rag.yml (sidecar + Qdrant + Neo4j; see compose.rag.env.example) ----
# docker compose -f compose.rag.yml --env-file compose.rag.env.example up -d --build
