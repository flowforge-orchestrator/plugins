# ---- external Docker network (раскомментируйте в docker-compose.yml) ----

# COMPOSE_NETWORK_NAME=conveyor

# ---- Opencore demo ----
SECRET_BACKEND=local
AUTH_PROVIDER=null
ENTITLEMENT_PROVIDER=allow-all
IDENTITY_UI=0
