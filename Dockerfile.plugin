# Multi-stage: build inside the image (no dist/ on the host required).
#
# Build context = repository root (this file and plugin packages live here).
# @kosolapus/plugin-ts-sdk resolves from npm (package-lock.json).
#
#   docker build -f Dockerfile.plugin --build-arg PLUGIN_DIR=telegram -t plugin-telegram:latest .
#
# docker-compose services use build.context: .

ARG NODE_IMAGE=node:24.22.2-alpine@sha256:a34ab6d7f6f4813f4d0c5469d74685604b962fbdbf5793a7bc7b4998ecb867c8
FROM ${NODE_IMAGE} AS build
ARG PLUGIN_DIR
WORKDIR /src

COPY . /src

RUN npm ci
RUN npm run build -w @conveyor/plugin-${PLUGIN_DIR}

FROM ${NODE_IMAGE}
ARG PLUGIN_DIR
WORKDIR /app
ENV NODE_ENV=production
ENV PLUGIN_MANAGER_RPC_PORT=3000

COPY --from=build /src/${PLUGIN_DIR}/dist/run.cjs ./run.cjs
COPY --from=build /src/${PLUGIN_DIR}/dist/help.md ./help.md
# Optional static bundle (dist/bundled/, dist/ui/ when present)
COPY --from=build /src/${PLUGIN_DIR}/dist/ /tmp/plugin-dist/
RUN if [ -d /tmp/plugin-dist/bundled ]; then cp -r /tmp/plugin-dist/bundled ./bundled; fi && \
    if [ -d /tmp/plugin-dist/ui ]; then cp -r /tmp/plugin-dist/ui ./ui; fi && \
    rm -rf /tmp/plugin-dist

USER node
CMD ["node", "run.cjs"]
