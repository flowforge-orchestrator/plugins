# RAG plugin — against local Conveyor demo + Ollama
PLUGIN_MANAGER_RPC_HOST=127.0.0.1
PLUGIN_MANAGER_RPC_PORT=14016
PLUGIN_MANAGER_INGRESS_TOKEN=key
CONTROL_PLANE_TCP_HOST=127.0.0.1
RUNTIME_CONTROL_PLANE_TCP_PORT=14021
PLUGIN_CONTROL_PLANE_KEY=key
PLUGIN_PULL_ADVERTISED_HOST=host.docker.internal
PLUGIN_TCP_PORT=9406
EXECUTOR_TCP_PORT=9406
PORT=9406
PLUGIN_HEALTH_HTTP_PORT=9407
PLUGIN_PUBLICATION_VERSION=0.0.3

QDRANT_URL=http://127.0.0.1:6333
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j-local
RAG_DATA_DIR=./.rag-data

# Local Ollama (embedder + mlx chat)
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL=embeddinggemma:latest
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=gemma4:12b-mlx
# Optional: force OpenAI-compat path instead of Ollama /api/chat
# LLM_API_STYLE=openai
RERANK_BASE_URL=http://127.0.0.1:11434/v1
RERANK_MODEL=qwen3:0.6b
RERANK_TIMEOUT_MS=120000