{
  "name": "@conveyor/plugin-rag",
  "version": "0.0.1",
  "description": "Conveyor plugin: document RAG with vector index, knowledge graph, and ask agent",
  "private": false,
  "main": "dist/run.cjs",
  "files": [
    "dist/run.cjs",
    "dist/help.md",
    "dist/ui/**",
    "package.json"
  ],
  "conveyorPluginBuild": {
    "helpMarkdown": "firstInDist",
    "bundleMarkdownAsText": true,
    "keepDistDirs": ["ui"]
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "copy:help": "node ../node_modules/@kosolapus/plugin-ts-sdk/scripts/copy-executor-help-md.cjs src dist",
    "build:ui": "node scripts/build-ui.mjs",
    "bundle": "node ../node_modules/@conveyor/plugin-build-tools/scripts/bundle.mjs",
    "prune:dist": "node ../node_modules/@conveyor/plugin-build-tools/scripts/prune-dist.mjs",
    "build": "tsc -p tsconfig.json && npm run copy:help && npm run build:ui && npm run bundle && npm run prune:dist",
    "start": "node dist/run.cjs",
    "start:dev": "nodemon",
    "test": "node ../node_modules/jest/bin/jest.js --config jest.config.cjs"
  },
  "dependencies": {
    "@kosolapus/plugin-ts-sdk": "0.0.10",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/microservices": "^11.1.12",
    "@nestjs/platform-express": "^11.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "neo4j-driver": "^5.28.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@conveyor/plugin-build-tools": "0.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.0",
    "vite": "^6.0.3",
    "vue": "^3.5.13"
  },
  "engines": {
    "node": ">=22"
  },
  "nodemonConfig": {
    "watch": ["src", "ui"],
    "ext": "ts,md,json,vue",
    "ignore": ["src/**/*.spec.ts"],
    "delay": "500",
    "exec": "npm run build && node dist/run.cjs"
  }
}
